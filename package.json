{
  "name": "dmx-whip-companion",
  "version": "0.12.0",
  "description": "Companion application for DMX whIP to monitor, record, and play back network DMX (Art-Net and sACN)",
  "main": "src/main/main.js",
  "scripts": {
    "prepare:generated": "node -e \"require('fs').mkdirSync('src/renderer/generated',{recursive:true})\"",
    "build:css": "npm run prepare:generated && tailwindcss -i ./src/renderer/input.css -o ./src/renderer/generated/tailwind.css --minify",
    "build:renderer": "npm run prepare:generated && esbuild src/renderer/bootstrap.js --bundle --outfile=src/renderer/generated/renderer.js --platform=browser",
    "build:ui": "npm run build:css && npm run build:renderer",
    "build:esptool": "node -e \"require('fs').mkdirSync('src/main/generated',{recursive:true})\" && esbuild node_modules/esptool-js/bundle.js --bundle --platform=node --format=cjs --outfile=src/main/generated/esptool.cjs",
    "prestart": "npm run build:ui && npm run build:esptool",
    "predev": "npm run build:ui && npm run build:esptool",
    "rebuild": "electron-rebuild -f -w serialport",
    "start": "electron .",
    "dev": "electron ."
  },
  "keywords": [
    "dmx",
    "artnet",
    "sacn",
    "lighting"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "esptool-js": "^0.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sacn": "^4.6.2",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^33.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
